# AI-OS · Execution Plane — environment template (Phase 0)
# Copy to `.env` (git-ignored) and fill in. `docker compose up` reads this.
#
# The golden rule: secret VALUES live only here and in the encrypted Secret Store.
# They must never reach an LLM, a log, or stdout (Phase 3 enforces the masking).

# ---- Postgres ----
POSTGRES_USER=aios
POSTGRES_PASSWORD=aios_dev_password
POSTGRES_DB=aios
POSTGRES_PORT=5432

# ---- Services ----
AIOS_ENV=development
API_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---- Sandbox (Phase 2) ----
# "docker" = single-use, non-root, network-denied containers (the real thing).
# "local"  = DEV-ONLY subprocess fallback. NOT ISOLATED. Requires AIOS_ALLOW_UNSAFE_LOCAL=1.
SANDBOX_RUNTIME=docker
SANDBOX_IMAGE=python:3.11-slim
AIOS_ALLOW_UNSAFE_LOCAL=0

# ---- LLM (Phase 4) — the only pay-per-use component ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Per-task token budget ceiling (Phase 4 loop guard).
LLM_TOKEN_BUDGET=40000
