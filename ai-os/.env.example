# AI-OS · Execution Plane — environment template (Phase 0)
# Copy to `.env` (git-ignored) and fill in. `docker compose up` reads this.
#
# The golden rule: secret VALUES live only here and in the encrypted Secret Store.
# They must never reach an LLM, a log, or stdout (Phase 3 enforces the masking).

# ---- Postgres ----
POSTGRES_USER=aios
POSTGRES_PASSWORD=aios_dev_password
POSTGRES_DB=aios
POSTGRES_PORT=5432

# ---- Services ----
AIOS_ENV=development
API_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---- Sandbox (Phase 2) ----
# "docker" = single-use, non-root, network-denied containers (the real thing).
# "local"  = DEV-ONLY subprocess fallback. NOT ISOLATED. Requires AIOS_ALLOW_UNSAFE_LOCAL=1.
SANDBOX_RUNTIME=docker
SANDBOX_IMAGE=python:3.11-slim
AIOS_ALLOW_UNSAFE_LOCAL=0

# ---- LLM (Phase 4) ----
# Provider: "gemini" (free tier, default) | "anthropic" (paid) | ...
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# Gemini free API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Only if you switch LLM_PROVIDER to anthropic (paid):
ANTHROPIC_API_KEY=
# Optional — OpenAI (paid):
OPENAI_API_KEY=
# NOTE: you don't have to edit this file by hand. Set keys in the UI
# (Connections → Edit); they're written back here (git-ignored) + masked.
# Claude (browser) needs NO key — it uses the manual copy-paste bridge.

# ---- Claude Code CLI provider (#5 — keyless orchestrator) ----
# The backend shells out to your OWN logged-in `claude` binary: no API key,
# no metered cost, no token injection. Run the backend on a machine where you
# are logged into Claude Code. Leave as-is unless `claude` is elsewhere.
AIOS_CLAUDE_CLI=claude
# Optional model alias for the CLI (e.g. opus / sonnet); empty = CLI default.
AIOS_CLAUDE_CLI_MODEL=
AIOS_CLAUDE_CLI_TIMEOUT=300
# Override the whole invocation if a CLI version changes its flags (advanced).
AIOS_CLAUDE_CLI_ARGS=
# BILLING SAFETY (default on): strip ANTHROPIC_API_KEY/_AUTH_TOKEN from the CLI's
# environment so `claude` uses your SUBSCRIPTION login, never metered API billing.
# If you're not logged in, the CLI fails cleanly instead of silently charging.
# Set to 0 only if you deliberately want the CLI to bill via the Anthropic API.
AIOS_CLAUDE_CLI_FORCE_SUBSCRIPTION=1
# Per-task token budget ceiling (Phase 4 loop guard).
LLM_TOKEN_BUDGET=40000
