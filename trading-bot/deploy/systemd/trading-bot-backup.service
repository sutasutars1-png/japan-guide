[Unit]
Description=Daily backup of the trading bot's data and logs

[Service]
Type=oneshot
User=bot
Group=bot
EnvironmentFile=/etc/trading-bot.env
ExecStart=/opt/trading-bot/japan-guide/trading-bot/deploy/backup.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/trading-bot
