# /etc/trading-bot.env — read by every trading-bot systemd unit (chmod 600, owner root).
# Paper trading only: nothing here can place a real order, and no private key belongs in this file.

# Market data source. "sodex" = SoDEX mainnet public gateway (read-only), BTC perpetual is BTC-USD.
EXCHANGE=sodex
SYMBOL=BTC-USD

# Extra arguments for `self-improve` (rules, costs). Defaults are the validated ones in README.
# Example: --committee   or   --fee-rate 0.0001 --carry-rate-per-day 0.0003
BOT_EXTRA_ARGS=

# Alerts: Discord or Slack incoming-webhook URL (empty = alerts only in the journal).
TRADING_BOT_WEBHOOK_URL=

# Daily backup to a *private* GitHub repository via a deploy key (empty = local tarballs only).
# The code repository is public, so never back up into it.
# Example: git@github.com:<you>/trading-bot-data.git
BACKUP_GIT_REMOTE=
BACKUP_SSH_KEY=/var/lib/trading-bot/.ssh/backup_ed25519
